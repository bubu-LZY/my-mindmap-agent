{
  "name": "mind-map-ai-agent",
  "version": "1.0.0",
  "description": "基于思维导图和大纲的 AI 智能体",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@svgdotjs/svg.js": "^3.2.0",
    "electron-store": "^8.1.0",
    "element-plus": "^2.5.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "simple-mind-map": "^0.12.0",
    "snappyjs": "^0.7.0",
    "sql.js": "^1.14.1",
    "tesseract.js": "^5.1.0",
    "tributejs": "^5.1.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mindmap.aiagent",
    "productName": "my-mindmap agent",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "my-mindmap agent",
      "include": "build/installer.nsh",
      "installerIcon": "electron/icons/icon.ico",
      "uninstallerIcon": "electron/icons/icon.ico"
    }
  }
}
